{
  "manifest_version": 3,
  "name": "Sunox Browser Bridge",
  "description": "Runs Suno generation challenges invisibly for the Sunox CLI.",
  "version": "__SUNOX_BRIDGE_RUNTIME_BUILD__",
  "version_name": "__SUNOX_VERSION__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://auth.suno.com/*",
    "https://suno.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/create*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://suno.com/create*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
