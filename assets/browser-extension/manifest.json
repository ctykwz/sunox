{
  "manifest_version": 3,
  "name": "Sunox Browser Bridge",
  "description": "Runs Suno generation challenges invisibly for the Sunox CLI.",
  "version": "__SUNOX_BRIDGE_RUNTIME_BUILD__",
  "version_name": "__SUNOX_BRIDGE_RUNTIME_BUILD__",
  "minimum_chrome_version": "128",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://suno.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; object-src 'none'; frame-src https://suno.com; connect-src http://127.0.0.1:*; worker-src 'self';"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["https://suno.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://suno.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
